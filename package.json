{
  "name": "dsh-model-image-input",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Per-model image-input checkboxes on third-party provider cards in the DSH Models settings page",
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "plugin", "vision", "multimodal"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hb2013/dsh-model-image-input.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-models"]
    }
  }
}
